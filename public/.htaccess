# Plain HTTP goes to HTTPS. Only the server's own word counts: a client can
# send any X-Forwarded-Proto it likes. hostUNO's front-end server redirects
# before this file is read ("Force SSL"), so the rule acts where that is off.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Sent with every response except a refusal (403), which is the server's own
# error page. Plain "Header set": hostUNO's nginx reads this file itself and
# skips "Header always set" without a word.
# HTTPS only, for a year, and for this host name alone — no includeSubDomains,
# no preload: the other akifuygun.com sites are not this file's to bind.
Header set Strict-Transport-Security "max-age=31536000"
Header set X-Content-Type-Options "nosniff"
# The browsers' default, spelled out: another site learns the origin, never the
# page. Not stricter — YouTube's player refuses a request without a referrer.
Header set Referrer-Policy "strict-origin-when-cross-origin"
# No page may show this site in a frame.
Header set X-Frame-Options "DENY"
Header set Content-Security-Policy "frame-ancestors 'none'"

# This directory is the web root, and everything in it is meant to be served.
# The rest of the checkout (includes/, scripts/, migrations/, config.php, .git)
# is beside it, where no URL leads. A directory's file list is not content:
# /api/ and /assets/ answer 403 instead of listing what they hold.
Options -Indexes

# Pretty URLs for the public SEO pages (mirrored by router.php for local dev).
# Each public page also exists under /tr/ for crawlable Turkish content.
# The id is an IMDB id, or the provisional id (tm…/mz…) of a title IMDB
# doesn't list — the patterns of SHOW_ID_PATTERN / MOVIE_ID_PATTERN (i18n.php).
RewriteRule ^(?:tr/)?series/(tt\d{6,10}|(?:tm|mz)\d{1,9})/?$ series.php?id=$1 [L,QSA]
RewriteRule ^(?:tr/)?movie/(tt\d{6,10}|tm\d{1,9})/?$ movie.php?id=$1 [L,QSA]
RewriteRule ^(?:tr/)?movies/?$ movies.php [L,QSA]
RewriteRule ^(?:tr/)?browse/?$ browse.php [L,QSA]
RewriteRule ^(?:tr/)?upcoming/?$ upcoming.php [L,QSA]
RewriteRule ^tr/?$ index.php [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
# The calendar's TV view (login-gated, so no /tr/ variant).
RewriteRule ^tv/?$ tv.php [L,QSA]

# Compress text responses. <IfModule> so it harmlessly no-ops if mod_deflate
# is unavailable.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
        application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Cache static assets. CSS/JS URLs carry ?v=<hash of their contents>
# (asset_version(), includes/assets.php), so a 1-year lifetime is safe — a
# change is a new URL. Images/icons rotate rarely
# (30 days); the PWA manifest is short (1 day) so updates propagate quickly.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
    ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>
